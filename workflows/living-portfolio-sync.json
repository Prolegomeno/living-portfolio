      "id": "7c9a450c-9759-4e4d-967f-e12a7b2db350",
      "name": "Combine Workflow List"
    },
    {
      "parameters": {
        "jsCode": "// Find Workflow Families\n// Mode: Run Once for All Items\n// Input: the workflows tagged \"Portfolio\" AND the workflows tagged \"Portfolio Part\",\n//        as one list (the output of Combine Workflow Lists).\n//\n// For every project (tagged \"Portfolio\") this finds its family: the sub-workflows it\n// calls, directly or through other sub-workflows, that are tagged \"Portfolio Part\".\n// It also finds the newest update date in the family, so editing a sub-workflow\n// makes the project count as changed.\n//\n// Rule of this node: a sub-workflow is only followed if it is tagged \"Portfolio Part\".\n// An untagged sub-workflow is never opened and never listed.\n// Only five plain values leave this node. Nothing else from the workflows is passed on.\n\nconst PROJECT_TAG = 'Portfolio';\nconst PART_TAG = 'Portfolio Part';\nconst MAX_DEPTH = 3; // a project, its parts, their parts, and their parts\nconst EXECUTE_WORKFLOW_TYPE = 'n8n-nodes-base.executeWorkflow';\n\nfunction hasTag(workflow, tagName) {\n  for (const tag of workflow.tags || []) {\n    const name = typeof tag === 'string' ? tag : tag && tag.name;\n    if (name === tagName) {\n      return true;\n    }\n  }\n  return false;\n}\n\n// Reads the identifier of the workflow that an \"Execute Workflow\" node calls.\n// Returns an empty text when it cannot be known for sure (for example, when it is\n// calculated by an expression, or loaded from a file or a web address).\nfunction readCalledWorkflowId(node) {\n  const params = node.parameters || {};\n\n  if (params.source !== undefined && params.source !== 'database') {\n    return '';\n  }\n\n  let value = params.workflowId;\n  if (value && typeof value === 'object') {\n    value = value.value;\n  }\n  if (typeof value !== 'string' || value === '' || value.startsWith('=')) {\n    return '';\n  }\n  return value;\n}\n\nfunction findCalledWorkflowIds(workflow) {\n  const ids = [];\n  for (const node of workflow.nodes || []) {\n    if (node.type !== EXECUTE_WORKFLOW_TYPE) {\n      continue;\n    }\n    const calledId = readCalledWorkflowId(node);\n    if (calledId !== '' && !ids.includes(calledId)) {\n      ids.push(calledId);\n    }\n  }\n  return ids;\n}\n\nfunction toTime(text) {\n  const time = new Date(text).getTime();\n  if (Number.isNaN(time)) {\n    return 0;\n  }\n  return time;\n}\n\n// 1. Put every workflow in a lookup by identifier (the same workflow can arrive twice)\nconst workflowsById = {};\nfor (const item of $input.all()) {\n  const workflow = item.json;\n  if (typeof workflow.id === 'string' && workflow.id !== '') {\n    workflowsById[workflow.id] = workflow;\n  }\n}\n\n// 2. For every project, walk through its family\nconst results = [];\nfor (const workflow of Object.values(workflowsById)) {\n  if (!hasTag(workflow, PROJECT_TAG)) {\n    continue;\n  }\n\n  const partIds = [];\n  const visited = {};\n  visited[workflow.id] = true;\n\n  let newestText = workflow.updatedAt;\n  let newestTime = toTime(workflow.updatedAt);\n\n  // Each round looks at one level of the family\n  let currentLevel = [workflow];\n  for (let depth = 1; depth <= MAX_DEPTH; depth++) {\n    const nextLevel = [];\n\n    for (const parent of currentLevel) {\n      for (const childId of findCalledWorkflowIds(parent)) {\n        const child = workflowsById[childId];\n        if (visited[childId] === true || !child || !hasTag(child, PART_TAG)) {\n          continue;\n        }\n        visited[childId] = true;\n        partIds.push(childId);\n        nextLevel.push(child);\n\n        if (toTime(child.updatedAt) > newestTime) {\n          newestTime = toTime(child.updatedAt);\n          newestText = child.updatedAt;\n        }\n      }\n    }\n\n    currentLevel = nextLevel;\n  }\n\n  results.push({\n    json: {\n      workflowId: workflow.id,\n      name: workflow.name,\n      lastUpdatedAt: newestText,\n      wordpressId: '',\n      partIds: partIds.join(',')\n    }\n  });\n}\n\nreturn results;"
      },
